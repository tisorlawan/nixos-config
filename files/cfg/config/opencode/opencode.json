{
  "$schema": "https://opencode.ai/config.json",
  "policies": [
    {
      "effect": "allow",
      "action": "provider.use",
      "resource": "*"
    },
    {
      "effect": "allow",
      "action": "provider.use",
      "resource": "opencode-go"
    },
    {
      "effect": "allow",
      "action": "provider.use",
      "resource": "cliproxyapi"
    }
  ],
  "plugins": ["*", "-opencode.provider.vllm"],
  "providers": {
    "cliproxyapi": {
      "name": "CLIProxyAPI",
      "env": [
        "CLIPROXYAPI_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible/responses",
      "settings": {
        "baseURL": "http://127.0.0.1:8317/v1"
      },
      "models": {
        "claude-opus-5-5": {
          "name": "Claude Opus 5.5",
          "package": "@opencode/ai/providers/anthropic-compatible",
          "limit": {
            "context": 200000
          }
        },
        "claude-haiku-5-5": {
          "name": "Claude Haiku 5.5",
          "package": "@opencode/ai/providers/anthropic-compatible",
          "limit": {
            "context": 200000
          }
        },
        "gpt-6.1-sol": {
          "name": "GPT 6.1 Sol",
          "limit": {
            "context": 272000
          }
        },
        "gpt-6-luna": {
          "name": "GPT 6 Luna",
          "limit": {
            "context": 272000
          }
        }
      }
    }
  }
}
