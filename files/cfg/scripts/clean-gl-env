#!/usr/bin/env bash
# Run a command with Ubuntu's Mesa, Vulkan, and VA-API drivers instead of the Nix ones.
# Hyprland starts under nixGLIntel, so every app it launches inherits Nix driver paths.
# Ubuntu-built apps that load those Nix drivers fall back to software rendering.
#
# Usage: clean-gl-env COMMAND [ARGS...]
set -euo pipefail

unset LD_LIBRARY_PATH LIBGL_DRIVERS_PATH GBM_BACKENDS_PATH LIBVA_DRIVERS_PATH
unset __EGL_VENDOR_LIBRARY_DIRS __EGL_VENDOR_LIBRARY_FILENAMES VK_ICD_FILENAMES

exec "$@"
