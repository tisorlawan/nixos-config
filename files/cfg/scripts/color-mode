#!/usr/bin/env bash
#
# Print the color mode, dark or light: $COLOR when set, else ~/.color, which
# ~/.scripts/set-color writes. Anything without "light" is dark.

set -euo pipefail

mode="${COLOR:-}"

if [ -z "$mode" ] && [ -f "$HOME/.color" ]; then
    mode="$(< "$HOME/.color")"
fi

case "$mode" in
    *[Ll][Ii][Gg][Hh][Tt]*) printf '%s\n' light ;;
    *) printf '%s\n' dark ;;
esac
