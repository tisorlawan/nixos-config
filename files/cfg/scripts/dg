#!/usr/bin/env python3
"""Encrypt a directory (including its names) into one GPG file, or restore it.

Usage:
    dg DIRECTORY [-o ENCRYPTED_FILE]
    dg ENCRYPTED_FILE [-o DESTINATION_DIRECTORY]
    dg --play ENCRYPTED_FILE

Directories are encrypted into extensionless, randomly named files by default.
Encrypted files are decrypted to their original directory beside the input.
With -o, decryption uses that path as the restored directory name.
On success, encryption removes the source directory and normal decryption
removes the encrypted archive. --play keeps the archive and plays from a private
/tmp/mpv-<random> directory; plaintext is removed after mpv exits.
"""

import argparse
import os
import secrets
import shutil
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path

RECIPIENT = "tisorlawan@gmail.com"


def output_path(input_path, output):
    return Path(output).absolute() if output else input_path.parent / secrets.token_hex(12)


def encrypt(source, destination):
    if not source.is_dir() or source.is_symlink():
        raise ValueError(f"Not a directory: {source}")
    source_root = source.resolve()
    output_parent = destination.parent.resolve()
    if output_parent == source_root or source_root in output_parent.parents:
        raise ValueError("Archive must be outside the source directory")
    if destination.exists():
        raise FileExistsError(destination)
    if not destination.parent.is_dir():
        raise ValueError(f"Output parent does not exist: {destination.parent}")

    def restorable(member):
        # Do not delete a source containing links to data outside the archive.
        if member.issym():
            link_target = ((source.parent / member.name).parent / member.linkname).resolve()
            if link_target != source_root and source_root not in link_target.parents:
                raise ValueError(f"Symlink points outside the directory: {member.name}")
        # Refuse entries that the decrypt-side safety filter cannot restore.
        tarfile.data_filter(member, source.parent)
        return member

    fd, temporary = tempfile.mkstemp(prefix=".directory-gpg-", dir=destination.parent)
    try:
        with os.fdopen(fd, "wb") as encrypted:
            process = subprocess.Popen(
                ["gpg", "--batch", "--no-tty", "--compress-algo", "none",
                 "--encrypt", "--recipient", RECIPIENT, "--output", "-"],
                stdin=subprocess.PIPE, stdout=encrypted,
            )
            try:
                with process.stdin, tarfile.open(fileobj=process.stdin, mode="w|") as archive:
                    archive.add(source, arcname=source.name, filter=restorable)
            except Exception:
                process.stdin.close()
                process.wait()
                raise
            if process.wait() != 0:
                raise RuntimeError("GPG encryption failed")
        # Link without replacing an output another process created meanwhile.
        os.link(temporary, destination)
        shutil.rmtree(source)
    finally:
        os.unlink(temporary)


def decrypt(source, destination, remove_source=True):
    if not source.is_file():
        raise ValueError(f"Not an encrypted file: {source}")
    output_parent = destination.parent if destination is not None else source.parent
    if destination is not None and destination.exists():
        raise FileExistsError(destination)
    if not output_parent.is_dir():
        raise ValueError(f"Output parent does not exist: {output_parent}")

    temporary = Path(tempfile.mkdtemp(prefix=".directory-gpg-", dir=output_parent))
    try:
        process = subprocess.Popen(
            ["gpg", "--batch", "--no-tty", "--decrypt", "--output", "-", str(source)],
            stdout=subprocess.PIPE,
        )
        try:
            with process.stdout, tarfile.open(fileobj=process.stdout, mode="r|*") as archive:
                # Blocks absolute paths, traversal, unsafe links and special files.
                archive.extractall(temporary, filter="data")
        except Exception:
            process.stdout.close()
            process.wait()
            raise
        if process.wait() != 0:
            raise RuntimeError("GPG decryption or integrity check failed")
        roots = list(temporary.iterdir())
        if len(roots) != 1 or not roots[0].is_dir() or roots[0].is_symlink():
            raise ValueError("Archive must contain one top-level directory")
        destination = destination or source.parent / roots[0].name
        if destination.exists():
            raise FileExistsError(destination)
        roots[0].rename(destination)
        if remove_source:
            source.unlink()
        return destination
    finally:
        if temporary.exists():
            shutil.rmtree(temporary)


def play(source):
    with tempfile.TemporaryDirectory(prefix="mpv-", dir="/tmp") as private:
        directory = Path(private)
        restored = directory / secrets.token_hex(12)
        decrypt(source, restored, remove_source=False)
        # Play directly from /tmp/mpv-<random>, not a nested archive name.
        for entry in restored.iterdir():
            entry.rename(directory / entry.name)
        restored.rmdir()
        return subprocess.run(["mpv", "--", str(directory)]).returncode


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--play", action="store_true", help="decrypt a GPG file privately, play it with mpv, then remove the temporary files")
    parser.add_argument("input", type=Path, help="directory to encrypt or GPG file to decrypt")
    parser.add_argument("-o", "--output", type=Path, help="encrypted output file or restored directory (not used with --play)")
    args = parser.parse_args()
    source = args.input.absolute()
    try:
        if args.play:
            if args.output:
                parser.error("--output cannot be used with --play")
            return play(source)
        if source.is_dir() and not source.is_symlink():
            destination = output_path(source, args.output)
            encrypt(source, destination)
        elif source.is_file():
            destination = decrypt(source, args.output.absolute() if args.output else None)
        else:
            raise ValueError(f"Input must be a directory or encrypted file: {source}")
    except (OSError, ValueError, RuntimeError, tarfile.TarError) as error:
        parser.exit(1, f"Error: {error}\n")
    print(destination)
    return 0


if __name__ == "__main__":
    sys.exit(main())
