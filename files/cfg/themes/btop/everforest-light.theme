# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#f4fef5"

# Main text color
theme[main_fg]="#5c6a72"

# Title color for boxes
theme[title]="#5c6a72"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#3a94c5"

# Background color of selected item in processes box
theme[selected_bg]="#e9f0e9"

# Foreground color of selected item in processes box
theme[selected_fg]="#3a94c5"

# Color of inactive/disabled text
theme[inactive_fg]="#939f91"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#5c6a72"

# Background color of the percentage meters
theme[meter_bg]="#e9f0e9"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#5c6a72"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#df69ba"
theme[mem_box]="#8da101"
theme[net_box]="#f85552"
theme[proc_box]="#3a94c5"

# Box divider line and small boxes line color
theme[div_line]="#939f91"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#8da101"
theme[temp_mid]="#dfa000"
theme[temp_end]="#f85552"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#35a77c"
theme[cpu_mid]="#3a94c5"
theme[cpu_end]="#df69ba"

# Mem/Disk free meter
theme[free_start]="#df69ba"
theme[free_mid]="#3a94c5"
theme[free_end]="#35a77c"

# Mem/Disk cached meter
theme[cached_start]="#3a94c5"
theme[cached_mid]="#35a77c"
theme[cached_end]="#df69ba"

# Mem/Disk available meter
theme[available_start]="#dfa000"
theme[available_mid]="#f85552"
theme[available_end]="#f85552"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#8da101"
theme[used_mid]="#35a77c"
theme[used_end]="#3a94c5"

# Download graph colors
theme[download_start]="#dfa000"
theme[download_mid]="#f85552"
theme[download_end]="#f85552"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#8da101"
theme[upload_mid]="#35a77c"
theme[upload_end]="#3a94c5"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#35a77c"
theme[process_mid]="#3a94c5"
theme[process_end]="#df69ba"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#f4fef5"
theme[gradient_color_1]="#e0eee2"
theme[gradient_color_2]="#e9f0e9"
theme[gradient_color_3]="#939f91"
theme[gradient_color_4]="#939f91"
theme[gradient_color_5]="#5c6a72"
theme[gradient_color_6]="#5c6a72"
theme[gradient_color_7]="#5c6a72"
