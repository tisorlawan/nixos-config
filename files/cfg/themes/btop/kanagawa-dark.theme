# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#1f1f28"

# Main text color
theme[main_fg]="#dcd7ba"

# Title color for boxes
theme[title]="#dcd7ba"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#7e9cd8"

# Background color of selected item in processes box
theme[selected_bg]="#223249"

# Foreground color of selected item in processes box
theme[selected_fg]="#7e9cd8"

# Color of inactive/disabled text
theme[inactive_fg]="#727169"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#dcd7ba"

# Background color of the percentage meters
theme[meter_bg]="#223249"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#dcd7ba"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#957fb8"
theme[mem_box]="#98bb6c"
theme[net_box]="#e46876"
theme[proc_box]="#7e9cd8"

# Box divider line and small boxes line color
theme[div_line]="#727169"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#98bb6c"
theme[temp_mid]="#e6c384"
theme[temp_end]="#e46876"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#7aa89f"
theme[cpu_mid]="#7e9cd8"
theme[cpu_end]="#957fb8"

# Mem/Disk free meter
theme[free_start]="#957fb8"
theme[free_mid]="#7e9cd8"
theme[free_end]="#7aa89f"

# Mem/Disk cached meter
theme[cached_start]="#7e9cd8"
theme[cached_mid]="#7aa89f"
theme[cached_end]="#957fb8"

# Mem/Disk available meter
theme[available_start]="#e6c384"
theme[available_mid]="#e46876"
theme[available_end]="#e46876"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#98bb6c"
theme[used_mid]="#7aa89f"
theme[used_end]="#7e9cd8"

# Download graph colors
theme[download_start]="#e6c384"
theme[download_mid]="#e46876"
theme[download_end]="#e46876"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#98bb6c"
theme[upload_mid]="#7aa89f"
theme[upload_end]="#7e9cd8"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#7aa89f"
theme[process_mid]="#7e9cd8"
theme[process_end]="#957fb8"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#1f1f28"
theme[gradient_color_1]="#2a2a37"
theme[gradient_color_2]="#223249"
theme[gradient_color_3]="#727169"
theme[gradient_color_4]="#727169"
theme[gradient_color_5]="#dcd7ba"
theme[gradient_color_6]="#dcd7ba"
theme[gradient_color_7]="#dcd7ba"
