# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#002b36"

# Main text color
theme[main_fg]="#839496"

# Title color for boxes
theme[title]="#839496"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#268bd2"

# Background color of selected item in processes box
theme[selected_bg]="#083e55"

# Foreground color of selected item in processes box
theme[selected_fg]="#268bd2"

# Color of inactive/disabled text
theme[inactive_fg]="#586e75"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#839496"

# Background color of the percentage meters
theme[meter_bg]="#083e55"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#839496"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#d33682"
theme[mem_box]="#859900"
theme[net_box]="#dc322f"
theme[proc_box]="#268bd2"

# Box divider line and small boxes line color
theme[div_line]="#586e75"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#859900"
theme[temp_mid]="#b58900"
theme[temp_end]="#dc322f"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#2aa198"
theme[cpu_mid]="#268bd2"
theme[cpu_end]="#d33682"

# Mem/Disk free meter
theme[free_start]="#d33682"
theme[free_mid]="#268bd2"
theme[free_end]="#2aa198"

# Mem/Disk cached meter
theme[cached_start]="#268bd2"
theme[cached_mid]="#2aa198"
theme[cached_end]="#d33682"

# Mem/Disk available meter
theme[available_start]="#b58900"
theme[available_mid]="#dc322f"
theme[available_end]="#dc322f"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#859900"
theme[used_mid]="#2aa198"
theme[used_end]="#268bd2"

# Download graph colors
theme[download_start]="#b58900"
theme[download_mid]="#dc322f"
theme[download_end]="#dc322f"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#859900"
theme[upload_mid]="#2aa198"
theme[upload_end]="#268bd2"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#2aa198"
theme[process_mid]="#268bd2"
theme[process_end]="#d33682"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#002b36"
theme[gradient_color_1]="#073642"
theme[gradient_color_2]="#083e55"
theme[gradient_color_3]="#586e75"
theme[gradient_color_4]="#586e75"
theme[gradient_color_5]="#839496"
theme[gradient_color_6]="#839496"
theme[gradient_color_7]="#839496"
