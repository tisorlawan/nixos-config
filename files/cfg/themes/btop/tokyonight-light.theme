# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#e1e2e7"

# Main text color
theme[main_fg]="#3760bf"

# Title color for boxes
theme[title]="#3760bf"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#2e7de9"

# Background color of selected item in processes box
theme[selected_bg]="#bdcee7"

# Foreground color of selected item in processes box
theme[selected_fg]="#2e7de9"

# Color of inactive/disabled text
theme[inactive_fg]="#848cb5"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#3760bf"

# Background color of the percentage meters
theme[meter_bg]="#bdcee7"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#3760bf"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#9854f1"
theme[mem_box]="#587539"
theme[net_box]="#f52a65"
theme[proc_box]="#2e7de9"

# Box divider line and small boxes line color
theme[div_line]="#848cb5"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#587539"
theme[temp_mid]="#8c6c3e"
theme[temp_end]="#f52a65"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#007197"
theme[cpu_mid]="#2e7de9"
theme[cpu_end]="#9854f1"

# Mem/Disk free meter
theme[free_start]="#9854f1"
theme[free_mid]="#2e7de9"
theme[free_end]="#007197"

# Mem/Disk cached meter
theme[cached_start]="#2e7de9"
theme[cached_mid]="#007197"
theme[cached_end]="#9854f1"

# Mem/Disk available meter
theme[available_start]="#8c6c3e"
theme[available_mid]="#f52a65"
theme[available_end]="#f52a65"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#587539"
theme[used_mid]="#007197"
theme[used_end]="#2e7de9"

# Download graph colors
theme[download_start]="#8c6c3e"
theme[download_mid]="#f52a65"
theme[download_end]="#f52a65"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#587539"
theme[upload_mid]="#007197"
theme[upload_end]="#2e7de9"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#007197"
theme[process_mid]="#2e7de9"
theme[process_end]="#9854f1"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#e1e2e7"
theme[gradient_color_1]="#c4c8da"
theme[gradient_color_2]="#bdcee7"
theme[gradient_color_3]="#848cb5"
theme[gradient_color_4]="#848cb5"
theme[gradient_color_5]="#3760bf"
theme[gradient_color_6]="#3760bf"
theme[gradient_color_7]="#3760bf"
