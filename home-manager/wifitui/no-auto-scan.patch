+func TestListModel_ScansOnlyOnRequest(t *testing.T) {
+	m := NewListModel()
+	m.Update(tea.WindowSizeMsg{Width: 100, Height: 30})
+
+	if msg := m.OnEnter()(); msg != (scanMsg{cached: true}) {
+		t.Fatalf("OnEnter sent %#v, want a cached scanMsg", msg)
+	}
+
+	// Three list loads used to slow down, and so start, the scan schedule.
+	loaded := scanFinishedMsg([]wifi.Connection{{SSID: "TestNet1"}})
+	for range 3 {
+		m.Update(loaded)
+	}
+
+	if m.scanner.interval != ScanOff {
+		t.Errorf("scan schedule is %v after three list loads, want off", m.scanner.interval)
+	}
+	if _, cmd := m.Update(tea.KeyMsg{Type: tea.KeyRunes, Runes: []rune("s")}); cmd == nil || cmd() != (scanMsg{}) {
+		t.Errorf("s did not request a scan")
+	}
+}
